    LTEXT "URL", 1004, 12, 49, 34, 14
    EDITTEXT 1002, 48, 46, 300, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", 1005, 12, 77, 336, 22
    DEFPUSHBUTTON "Save", IDOK, 203, 109, 68, 23
    PUSHBUTTON "Cancel", IDCANCEL, 280, 109, 68, 23
END
