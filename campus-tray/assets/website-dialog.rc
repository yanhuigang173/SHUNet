#include <windows.h>

// ASCII resource source; Chinese text is assigned with the Unicode API at runtime.
101 DIALOGEX 0, 0, 260, 166
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Website"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 1600, 0, 0, 100, 20
    LTEXT "", 1601, 0, 0, 100, 20
    LTEXT "Name", 1003, 12, 15, 34, 14
