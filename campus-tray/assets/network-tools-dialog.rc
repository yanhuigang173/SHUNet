#include <windows.h>
#include <commctrl.h>

105 DIALOGEX 0, 0, 400, 320
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "SHUNet"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 1600, 0, 0, 100, 20
    LTEXT "", 1601, 0, 0, 100, 20
    LTEXT "", 1701, 0, 0, 100, 20
    COMBOBOX 1702, 0, 0, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", 1730, 0, 0, 100, 20
    LTEXT "", 1731, 0, 0, 100, 20
    LTEXT "", 1732, 0, 0, 100, 20
    LTEXT "", 1733, 0, 0, 100, 20
    LTEXT "", 1734, 0, 0, 100, 20
    LTEXT "", 1735, 0, 0, 100, 20
    LTEXT "", 1736, 0, 0, 100, 20
    LTEXT "", 1737, 0, 0, 100, 20
    EDITTEXT 1710, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT 1711, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT 1712, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT 1713, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT 1714, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT 1715, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT 1716, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT 1717, 0, 0, 100, 20, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Copy", 1750, 0, 0, 100, 20
    PUSHBUTTON "Copy", 1751, 0, 0, 100, 20
    PUSHBUTTON "Copy", 1752, 0, 0, 100, 20
    PUSHBUTTON "Copy", 1753, 0, 0, 100, 20
    PUSHBUTTON "Copy", 1754, 0, 0, 100, 20
    PUSHBUTTON "Copy", 1755, 0, 0, 100, 20
    PUSHBUTTON "Copy", 1756, 0, 0, 100, 20
    PUSHBUTTON "Copy", 1757, 0, 0, 100, 20
    LTEXT "", 1703, 0, 0, 100, 20
    LTEXT "", 1704, 0, 0, 100, 20
    PUSHBUTTON "Refresh", 1705, 0, 0, 100, 20
    PUSHBUTTON "Copy all", 1706, 0, 0, 100, 20
    DEFPUSHBUTTON "Close", IDCANCEL, 0, 0, 100, 20
END

106 DIALOGEX 0, 0, 450, 300
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "SHUNet"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 1600, 0, 0, 100, 20
    LTEXT "", 1601, 0, 0, 100, 20
    LTEXT "", 1701, 0, 0, 100, 20
    COMBOBOX 1702, 0, 0, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", 1720, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_VSCROLL, 0, 0, 100, 100
    LTEXT "", 1703, 0, 0, 100, 20
    LTEXT "", 1704, 0, 0, 100, 20
    PUSHBUTTON "Refresh", 1705, 0, 0, 100, 20
    PUSHBUTTON "Copy all", 1706, 0, 0, 100, 20
    PUSHBUTTON "Copy IP", 1707, 0, 0, 100, 20
    DEFPUSHBUTTON "Close", IDCANCEL, 0, 0, 100, 20
END
