#include <windows.h>

102 DIALOGEX 0, 0, 360, 274
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Help"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 1600, 0, 0, 100, 20
    LTEXT "", 1601, 0, 0, 100, 20
    EDITTEXT 1101, 12, 12, 406, 266, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Copy", 1102, 248, 291, 78, 23
    DEFPUSHBUTTON "Close", IDOK, 336, 291, 82, 23
END
