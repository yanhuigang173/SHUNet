#include <windows.h>
#include <commctrl.h>

108 DIALOGEX 0, 0, 440, 350
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "SHUNet"
FONT 9, "Segoe UI"
BEGIN
