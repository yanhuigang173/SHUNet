    LTEXT "",1932,0,0,100,20
    COMBOBOX 1902,0,0,100,150,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "",1933,0,0,100,20
    EDITTEXT 1903,0,0,100,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "",1904,"SysDateTimePick32",DTS_SHORTDATEFORMAT | WS_TABSTOP,0,0,100,20
    CONTROL "",1905,"SysDateTimePick32",DTS_TIMEFORMAT | WS_TABSTOP,0,0,100,20
