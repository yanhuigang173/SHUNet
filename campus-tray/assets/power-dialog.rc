    LTEXT "",1908,0,0,100,40
    LTEXT "",1909,0,0,100,40
    DEFPUSHBUTTON "Create",IDOK,0,0,100,20
    LTEXT "",1935,0,0,100,20
    CONTROL "",1920,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP,0,0,100,100
    LTEXT "",1914,0,0,100,60
    LTEXT "",1915,0,0,100,20
    PUSHBUTTON "Cancel",1912,0,0,100,20
    PUSHBUTTON "Remove",1913,0,0,100,20
    PUSHBUTTON "Refresh",1911,0,0,100,20
